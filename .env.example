# ─── Inference ───────────────────────────────────────────────────────────────
# Any OpenAI-compatible chat-completions endpoint. The agent loop does not care
# which provider; the deployed build points these at Groq.
VITE_AI_BASE_URL=https://api.groq.com/openai/v1
VITE_AI_API_KEY=
VITE_AI_MODEL=openai/gpt-oss-120b

# Same provider, SEPARATE rate-limit bucket. When the primary hits its
# tokens-per-minute cap even after backoff, the agent retries the identical
# request on this model. Must be tool-call capable, and must still exist —
# a decommissioned model here makes the whole rate-limit path a dead end.
VITE_AI_FALLBACK_MODEL=openai/gpt-oss-20b


# ─── Sibyl memory sidecar ────────────────────────────────────────────────────
# Where sibyl-svc is reachable and the bearer token it expects. SERVER-SIDE
# ONLY: deliberately no VITE_ prefix, because a VITE_ var is inlined into the
# client bundle and a public service token means anyone can read or write any
# tenant's memory. Read in Node by api/memory.ts (prod) and the Vite dev proxy.
# Generate the token with:
#   python -c "import secrets;print(secrets.token_urlsafe(24))"
# and set the SAME value as STASH_SVC_TOKEN on the sidecar host.
SIBYL_SVC_URL=http://127.0.0.1:8787
SIBYL_SVC_TOKEN=

# Which wallet's memory the app reads. A stand-in until wallet-connect lands,
# after which the connected account supplies it. Not secret; it is inlined.
VITE_MEMORY_TENANT=0x0000000000000000000000000000000000000000
