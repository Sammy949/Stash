# Copy to .env for local runs; set these as secrets on the host for deploys.
# Never commit real values. .env is gitignored.

# Shared bearer token the Stash serverless proxy presents on every call.
# Generate with:  python -c "import secrets;print(secrets.token_urlsafe(24))"
STASH_SVC_TOKEN=

# Where the SQLite memory file lives. Locally anything writable; on a host with a
# volume this must point INSIDE it (e.g. /data/memory.db). On an ephemeral host
# (a free Hugging Face Space) any writable path is fine, because durability comes
# from the snapshot settings below instead.
SIBYL_DB_PATH=

# --- Durability on an ephemeral disk (persist.py) ---------------------------
# Without these the database is disk-only and dies with the container. With them
# the service restores on boot and snapshots (VACUUM INTO) after every write.
#
# Private dataset repo to push snapshots to, e.g. your-username/stash-memory.
SIBYL_SNAPSHOT_REPO=
# Write-scoped HF token. NOT the same token as a private Space's access gate.
SIBYL_SNAPSHOT_HF_TOKEN=
# Offline alternative, no token or network: snapshot into this directory instead.
# Ignored when SIBYL_SNAPSHOT_REPO + token are set.
SIBYL_SNAPSHOT_DIR=
# Seconds to coalesce writes before uploading. This is the worst-case loss window
# on a hard kill; a graceful shutdown and POST /snapshot both flush immediately.
SIBYL_SNAPSHOT_DEBOUNCE_S=20

# From `sibyl init` (~/.sibyl-memory/credentials.json). Optional: without them
# the client still works, but the tier/cap check cannot be server-verified.
SIBYL_ACCOUNT_ID=
SIBYL_SESSION_TOKEN=
SIBYL_TIER=free

# Sibyl reports aggregate op COUNTS (never memory contents) to its API on an
# activated account. Set to 0 to disable that heartbeat.
SIBYL_MEMORY_TELEMETRY=1
