# Copy to .env for local runs; set these as secrets on the host for deploys.
# Never commit real values. .env is gitignored.

# Shared bearer token the Stash serverless proxy presents on every call.
# Generate with:  python -c "import secrets;print(secrets.token_urlsafe(24))"
STASH_SVC_TOKEN=

# Where the SQLite memory file lives. Locally anything writable; on a host this
# must point INSIDE the mounted persistent volume (e.g. /data/memory.db).
SIBYL_DB_PATH=

# From `sibyl init` (~/.sibyl-memory/credentials.json). Optional: without them
# the client still works, but the tier/cap check cannot be server-verified.
SIBYL_ACCOUNT_ID=
SIBYL_SESSION_TOKEN=
SIBYL_TIER=free

# Sibyl reports aggregate op COUNTS (never memory contents) to its API on an
# activated account. Set to 0 to disable that heartbeat.
SIBYL_MEMORY_TELEMETRY=1
